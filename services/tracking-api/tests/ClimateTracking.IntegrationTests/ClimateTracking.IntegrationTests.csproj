<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      4.14.0, the first release off the vulnerable SSH.NET, matching what
      ClimateProject.IntegrationTests was moved to. Restore of this project fails outright
      without it (NU1903 as an error), so until this bump nothing in this solution's
      integration suite could be built or run at all.
    -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClimateTracking.Infrastructure\ClimateTracking.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ClimateTracking.Api\ClimateTracking.Api.csproj" />
    <ProjectReference Include="..\..\src\ClimateTracking.Workers\ClimateTracking.Workers.csproj" />
  </ItemGroup>

</Project>

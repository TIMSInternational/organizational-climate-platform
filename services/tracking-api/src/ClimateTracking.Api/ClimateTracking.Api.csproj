<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ClimateTracking.Application\ClimateTracking.Application.csproj" />
    <ProjectReference Include="..\ClimateTracking.Infrastructure\ClimateTracking.Infrastructure.csproj" />
    <!--
      ONE PROCESS, TWO JOBS. The API image IS the scheduler: Program.cs calls
      AddClimateTrackingWorkers, so CacheSyncWorker and DailySemaforoWorker deploy with
      the API and ClimateTracking.Workers' own Program.cs (its standalone host) is kept
      unbuilt as the documented opt-out. Same shape #275 chose for climate-project.

      Not a preference: App Runner requires the container to listen on the configured
      port and pass a health check, and ClimateTracking.Workers is a Host, not a
      WebApplication, so it never binds a port. A second App Runner service running the
      Workers image is not an option that was rejected; it is not available.
    -->
    <ProjectReference Include="..\ClimateTracking.Workers\ClimateTracking.Workers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
      <!--
      Pinned ONLY to lift a transitive package out of a published advisory, not because
      anything here calls it. `Microsoft.EntityFrameworkCore.Design` -> `Microsoft.Build.Tasks.Core`
      -> `System.Security.Cryptography.Pkcs 9.0.0`, which GHSA-846f-f764-76mx (high) and
      GHSA-2fmv-rv2c-59x7 (moderate) cover. `NuGetAudit` promotes both to errors, so the day
      the advisory published, `dotnet build` began failing on BOTH solutions with no commit
      behind it; CI went red on main at 2026-10-14T15:50Z having passed at 03:31Z.

      The Design package is `PrivateAssets=all`, so the vulnerable assembly was never in the
      deployed image: this is a broken gate rather than a live exposure. Pinned rather than
      suppressed because a suppression hides the next advisory on the same package too, and
      10.0.13 is the version the running API already reports from /version.

      Delete this when the Design package's own graph moves past it; nothing in this codebase
      references Pkcs directly, so the pin is removable with a build and no code change.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
</ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The secrets store this service's five local-dev values live in. Committed on
      purpose: the id is a pointer, not a secret, and without it in the project every
      developer's `dotnet user-secrets` writes to a different store.
    -->
    <UserSecretsId>86bbfb95-a955-44a2-bbea-2152b1306109</UserSecretsId>
  </PropertyGroup>

  <!--
    Build provenance for GET /version, read back through BuildInfo.cs.

    The SDK turns each AssemblyMetadata item into an AssemblyMetadataAttribute on the
    output assembly, so a value passed as `/p:CommitSha=<sha>` is readable at runtime
    with no generated file and no source change. services/tracking-api/Dockerfile
    already threads COMMIT_SHA and BUILD_TIMESTAMP through to exactly these two
    properties; deploy-tracking-prod.yml passes the real commit and build time.

    The "unknown" defaults are what make a provenance-less build distinguishable rather
    than merely blank: scripts/read-deployed-commit.sh exits 1 on "unknown" with a
    message saying an image built outside the CI path is serving traffic. An empty
    default would be handed on as though it were a commit.
  -->
  <PropertyGroup>
    <CommitSha Condition="'$(CommitSha)' == ''">unknown</CommitSha>
    <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">unknown</BuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CommitSha" Value="$(CommitSha)" />
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClimateProject.Infrastructure\ClimateProject.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ClimateProject.Api\ClimateProject.Api.csproj" />
    <ProjectReference Include="..\..\src\ClimateProject.Workers\ClimateProject.Workers.csproj" />
  </ItemGroup>

  <!--
    The one reference that leaves this solution, and the only one (#153).

    climate-tracking is a separate solution (services/tracking-api/ClimateTracking.slnx) that
    this repo never builds together with this one; the two services share nothing at runtime
    but the symmetric TrackingJwtSecret, with ValidateIssuer and ValidateAudience both false.
    Nothing therefore proved that a token MINTED here is ACCEPTED there. Every test on both
    sides hand-builds its own ClaimsPrincipal, which is the one thing that cannot fail when
    the mint and the validation drift apart.

    CrossServiceTokenTests closes that by validating a real minted token against the real
    ClimateTracking.Application.Auth types. Referencing them beats copying them: a copied
    TokenValidationParameters would agree with the test forever, no matter what the other
    service went on to require. ClimateTracking.Application specifically, not .Api, so this
    pulls in one leaf assembly plus its Domain: no EF Core, no web host, and no second
    `Program` type for WebApplicationFactory to trip over. Test-only. No assembly under
    src/ references climate-tracking, and none should.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\services\tracking-api\src\ClimateTracking.Application\ClimateTracking.Application.csproj" />
  </ItemGroup>

</Project>

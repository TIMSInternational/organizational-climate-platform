# syntax=docker/dockerfile:1
#
# The standalone scheduler image. NOT NEEDED under the deployment #275 chose: the API host
# calls `AddClimateProjectScheduling` (see src/ClimateProject.Api/Program.cs), so the API image
# `Dockerfile` builds IS the scheduler, and nothing builds or deploys this file. It is kept,
# unbuilt, as the documented opt-out: if the jobs ever need a dedicated instance -- CPU
# isolation, a different scaling profile -- deploy this image and set Scheduling__Enabled=false
# on the API service. The advisory lease in `PostgresAdvisoryJobLease` makes either topology
# correct; the choice is operational cost, not correctness.
#
# One caveat if this host is ever deployed: it selects the real notification sender from the
# same Email options as the API, but its IScheduledReportRunner stays the logging stub -- the
# real runner (#91) lives in the API host with the report generator. Scheduled reports are
# generated and delivered by the co-hosted API, not by this process.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

ARG COMMIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

COPY . .
RUN dotnet restore ClimateProject.slnx
RUN dotnet publish src/ClimateProject.Workers/ClimateProject.Workers.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore \
    /p:UseAppHost=false \
    "/p:CommitSha=${COMMIT_SHA}" \
    "/p:BuildTimestamp=${BUILD_TIMESTAMP}"

# The runtime image, not the aspnet one: this host serves no HTTP. It also must not be an
# Alpine variant -- digests are scheduled in each recipient's own timezone, and Alpine ships
# without tzdata, so every IANA zone id would silently resolve to UTC and every non-UTC user
# would get their digest at the wrong hour with no error anywhere.
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app

ENV DOTNET_ENVIRONMENT=Production
ENV DOTNET_EnableDiagnostics=0

COPY --from=build /app/publish .

USER $APP_UID

ENTRYPOINT ["dotnet", "ClimateProject.Workers.dll"]

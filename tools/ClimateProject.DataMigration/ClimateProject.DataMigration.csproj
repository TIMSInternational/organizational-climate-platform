<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project is REFERENCED BY NOTHING that ships. It lives in its own solution
    (../ClimateProject.DataMigration.slnx), not in ClimateProject.slnx, because the
    production Dockerfile and CI both restore ClimateProject.slnx and this tool's
    dependencies (MongoDB.Driver here, Testcontainers.MongoDb in the tests) have no
    business in that graph. Referencing src/ projects FROM here is fine - the arrow
    points out of the shipped code, never into it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      For DeterministicNotificationId.Create - the repo's one RFC 4122 v5 implementation,
      already proven against the RFC test vector in DeterministicNotificationIdTests. The
      ETL must not grow a second v5 implementation: two generators that "should" agree is
      exactly how deterministic schemes silently stop being deterministic.
    -->
    <ProjectReference Include="..\..\src\ClimateProject.Application\ClimateProject.Application.csproj" />
    <!--
      For ClimateProjectDbContext (the loader writes through the same entity
      configurations the app reads through - re-implementing column maps in raw SQL is
      how an ETL drifts from the schema) and for DatabaseConnectionStringPolicy, whose
      transaction-pooler detection backs this tool's own refuse-6543 guard.
    -->
    <ProjectReference Include="..\..\src\ClimateProject.Infrastructure\ClimateProject.Infrastructure.csproj" />
  </ItemGroup>

</Project>

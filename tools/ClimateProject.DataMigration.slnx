<!--
  Deliberately its own solution. The production image build restores ClimateProject.slnx
  (Dockerfile:13) and CI restores/builds/tests the same file, so anything listed there joins
  the shipped restore graph. A one-off cutover tool must not: it drags MongoDB.Driver and
  Testcontainers.MongoDb into every production restore for code that never ships. Keeping the
  tool here means adding it to ClimateProject.slnx is an explicit act, not an accident.
-->
<Solution>
  <Folder Name="/tools/">
    <Project Path="ClimateProject.DataMigration/ClimateProject.DataMigration.csproj" />
    <Project Path="ClimateProject.DataMigration.Tests/ClimateProject.DataMigration.Tests.csproj" />
  </Folder>
</Solution>

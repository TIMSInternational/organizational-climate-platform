VITE_API_BASE_URL=http://localhost:5080
# Direct calls from the browser to climate-tracking (see web/src/features/tracking/api/trackingApi.ts).
# Inert until climate-tracking adds CORS support for this frontend's origin (#56 Plan B).
VITE_TRACKING_API_BASE_URL=http://localhost:5081

# OAuth client id for the "Continue with Google" button on /login (#81).
# Must be the SAME value as the API's `GoogleClientId` -- the API validates the
# ID token's audience against it. Leave empty and the button is not rendered at
# all; email + password sign-in is unaffected.
#
# The client must list <origin>/auth/loading as an authorized redirect URI.
VITE_GOOGLE_CLIENT_ID=

VITE_API_BASE_URL=http://localhost:5080
# Direct calls from the browser to climate-tracking (see web/src/features/tracking/api/trackingApi.ts),
# used by the /tracking/* screens (#126).
#
# The old note here said this was "inert until climate-tracking adds CORS support". That is
# out of date: ClimateTracking.Api/Program.cs calls AddCors(), builds a "Frontend" policy
# from Cors:AllowedOrigins with AllowAnyHeader/AllowAnyMethod, and app.UseCors("Frontend")
# runs before authentication. What is NOT done for you is the list itself --
# appsettings.json ships Cors:AllowedOrigins as an EMPTY array, and no manifest in this
# repo's infra/ deploys the tracking service, so every deployment has to put this frontend's
# origin in Cors__AllowedOrigins__0 on the climate-tracking side or the browser will block
# the preflight authFetch forces on every call (it always sets Authorization and
# Content-Type: application/json).
VITE_TRACKING_API_BASE_URL=http://localhost:5081

# OAuth client id for the "Continue with Google" button on /login (#81).
# Must be the SAME value as the API's `GoogleClientId` -- the API validates the
# ID token's audience against it. Leave empty and the button is not rendered at
# all; email + password sign-in is unaffected.
#
# The client must list <origin>/auth/loading as an authorized redirect URI.
VITE_GOOGLE_CLIENT_ID=

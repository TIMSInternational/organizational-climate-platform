<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ClimateProject.Application\ClimateProject.Application.csproj" />
    <ProjectReference Include="..\ClimateProject.Infrastructure\ClimateProject.Infrastructure.csproj" />
    <!--
      Co-hosting (#275): the API process is the scheduler. Program.cs calls
      AddClimateProjectScheduling, so the six jobs and the heartbeat monitor deploy with the
      API image `deploy-prod.yml` already builds; Dockerfile.workers stays only as the
      opt-out path if the jobs ever need a dedicated instance again. ClimateProject.Workers
      deliberately ships no appsettings.json (see WorkerHostFactory) so this reference cannot
      race the API's own configuration files into the publish output.
    -->
    <ProjectReference Include="..\ClimateProject.Workers\ClimateProject.Workers.csproj" />
  </ItemGroup>

  <!--
    Same arrangement ClimateProject.Infrastructure already uses for ClimateProject.UnitTests.
    Added for #146 so the rate-limiting partition functions can be exercised directly: they
    are pure functions of an HttpContext, and asserting on the partition key they return is
    the only way to prove the App Runner proxy fix without a production-shaped deployment.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ClimateProject.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <!--
      Pinned ONLY to lift a transitive package out of a published advisory, not because
      anything here calls it. `Microsoft.EntityFrameworkCore.Design` -> `Microsoft.Build.Tasks.Core`
      -> `System.Security.Cryptography.Pkcs 9.0.0`, which GHSA-846f-f764-76mx (high) and
      GHSA-2fmv-rv2c-59x7 (moderate) cover. `NuGetAudit` promotes both to errors, so the day
      the advisory published, `dotnet build` began failing on BOTH solutions with no commit
      behind it; CI went red on main at 2026-10-14T15:50Z having passed at 03:31Z.

      The Design package is `PrivateAssets=all`, so the vulnerable assembly was never in the
      deployed image: this is a broken gate rather than a live exposure. Pinned rather than
      suppressed because a suppression hides the next advisory on the same package too, and
      10.0.13 is the version the running API already reports from /version.

      Delete this when the Design package's own graph moves past it; nothing in this codebase
      references Pkcs directly, so the pin is removable with a build and no code change.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The id of the local user-secrets store. NOT a secret itself: it names a file under
      ~/.microsoft/usersecrets/ which never enters the repository. Without this line the
      Development configuration carries no InternalApiKey and the host refuses to start,
      so the API could be run only from the single working copy where somebody had added
      it by hand and left it uncommitted. A fresh clone, CI, or any second worktree got
      "Missing InternalApiKey configuration" and no indication of the cause.
    -->
    <UserSecretsId>727a5cc7-ac91-4063-83eb-1255759d052d</UserSecretsId>
  </PropertyGroup>

  <!--
    Build provenance surfaced by GET /version. See BuildInfo.cs for why.

    Both default to "unknown" rather than being left empty so that a plain
    `dotnet build` succeeds and reports an honest "no provenance" value. The
    Dockerfile overrides them from build args; deploy-prod.yml supplies the real
    commit SHA and build timestamp.
  -->
  <PropertyGroup>
    <CommitSha Condition="'$(CommitSha)' == ''">unknown</CommitSha>
    <BuildTimestamp Condition="'$(BuildTimestamp)' == ''">unknown</BuildTimestamp>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="CommitSha" Value="$(CommitSha)" />
    <AssemblyMetadata Include="BuildTimestamp" Value="$(BuildTimestamp)" />
  </ItemGroup>

</Project>

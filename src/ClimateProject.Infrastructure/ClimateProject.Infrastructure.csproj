<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClimateProject.Application\ClimateProject.Application.csproj" />
    <ProjectReference Include="..\ClimateProject.Domain\ClimateProject.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GoogleTokenVerifier.MapPayload is the /auth/google trust decision (#280). Every
         integration test swaps in FakeGoogleTokenVerifier, so nothing in the suite reaches
         the real class and the check was enforced only by a comment. Exposing it to the unit
         tests is what makes it enforced by a test instead. -->
    <InternalsVisibleTo Include="ClimateProject.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.9.0" />
    <PackageReference Include="Anthropic.Bedrock" Version="1.0.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <!-- Pinned to the same version as EF Core. Npgsql.EntityFrameworkCore.PostgreSQL only asks for
         Relational >= 10.0.4, so without this the integration tests resolved 10.0.4 (MSB3277)
         while the API, through EF Core Design, shipped 10.0.15: the tests ran a different EF
         than production. Keep it in step with Microsoft.EntityFrameworkCore. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
